# syntax=docker/dockerfile:1.7

# Build stage. BuildKit cache mounts on /go/pkg/mod and /root/.cache/go-build
# let module downloads and compiled object files persist across builds — and
# across CI runs when paired with `cache-from: type=gha` in the workflow.
FROM golang:1.25-alpine AS build
WORKDIR /src

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go mod download

COPY . .

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags='-s -w' \
    -o /out/runner ./cmd/runner

FROM debian:12-slim
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl nodejs npm python3 python3-pip git
RUN --mount=type=cache,target=/root/.cache/pip \
    pip3 install --break-system-packages --no-cache-dir uv
COPY --from=build /out/runner /runner
RUN useradd -r -s /bin/false runner
USER runner
ENTRYPOINT ["/runner"]
